# BotClaw Configuration Example
# Copy this to .env and fill in your values

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# OpenCode Server URL
# Default: http://localhost:4096
OPENCODE_SERVER_URL=http://localhost:4096

# OpenCode Server Password (optional)
# Set if you enabled auth on opencode serve
OPENCODE_SERVER_PASSWORD=

# Allowed Users (optional)
# Comma-separated list of Telegram usernames (with or without @)
# Leave empty to allow all users
USERS_ALLOWED=

# Allowed User IDs (optional)
# Comma-separated list of Telegram user IDs allowed to use the bot
# Get your user_id from @userinfobot or @getidsBot
# Leave empty to allow all users
USER_IDS_ALLOWED=

# Log Level
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# TTS Voice (edge-tts voice name)
# Default: es-MX-DaliaNeural
# Other options: es-ES-ElenaNeural, es-AR-TomasNeural, en-US-JennyNeural, etc.
TTS_VOICE=es-MX-DaliaNeural

# Default directory for /create command (when using project name only)
PROJECTS_BASE_DIR=~/projects